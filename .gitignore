# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Private environment files (public templates may be committed intentionally).
.env
.env.*
!.env.example
!.env.*.example

# Private package-manager, build and service credentials.
.npmrc
credentials.json
google-services.json
*service-account*.json
*serviceAccount*.json

# Additional Android signing material (existing key/certificate rules above apply).
*.keystore
*.pfx
keystore.properties
key.properties

# User exports and private restore journals; source/test fixtures stay visible.
/backups/
/backup-exports/
/momentum-backup-recovery/
momentum-backup-*.json
momentum-recovery-*.json
restore-*.before
restore-*.after
restore-*.prepared
restore-*.committed
restore-*.settled
restore-*.removed

# Generated Android builds and local EAS inspection output.
*.apk
*.aab
/.backup-*-check/
/eas-archive*/

# Local developer metadata; already tracked files remain tracked.
/.claude/
/.vscode/
